# Copy to .env and adjust. All values here have safe defaults if unset (see
# crates/api/src/config.rs) except ADMIN_PASSWORD, which you should always change.

# --- Storage ---
# Sqlite file path (or `sqlite::memory:` for an ephemeral, in-process-only database).
DATABASE_URL=sqlite://stellarrisk.db

# --- HTTP server ---
BIND_ADDR=127.0.0.1:8080
# Symmetric secret used to sign investigator session JWTs. Always override in any
# non-throwaway deployment.
JWT_SECRET=change-this-to-a-long-random-value

# --- Seeded admin investigator (created once, on first run, if no investigators exist) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-immediately

# --- Stellar ingestion ---
# Leave unset to run in demo mode (a small built-in set of synthetic transactions,
# including deliberately suspicious ones, is replayed instead of polling Horizon).
# HORIZON_URL=https://horizon-testnet.stellar.org
POLL_INTERVAL_SECS=15

# --- AI investigation assistant (Anthropic) ---
# Leave unset to disable AI advisories entirely — the rules engine, alerting, and human
# review workflow all continue to function normally without it.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# --- Soroban on-chain decision anchoring (optional) ---
# All three must be set to enable on-chain anchoring; otherwise it's a no-op. Requires
# the `stellar` CLI installed and configured with a funded identity matching
# SOROBAN_SOURCE_ACCOUNT, and DecisionAnchorContract already deployed + initialized
# with that account as admin (see crates/soroban_anchor/contract).
# SOROBAN_CONTRACT_ID=C...
# SOROBAN_NETWORK=testnet
# SOROBAN_SOURCE_ACCOUNT=stellarrisk-admin

# --- Logging ---
# Standard `tracing-subscriber` env filter, e.g. `info`, `debug`, `api=debug,warn`.
RUST_LOG=info
